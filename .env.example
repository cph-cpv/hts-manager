# Copy to .env and fill in. All configuration is via env vars — there are no CLI
# options. The directory to scan is HTSM_SCAN_PATH below.

# --- Access (required) ---
HTSM_PIN=                      # shared access PIN
HTSM_SESSION_SECRET=           # HMAC secret for the signed session cookie
HTSM_SECURE=                   # set to `false` to allow login over plain HTTP (default true)

# --- Storage ---
HTSM_DB_PATH=./hts-manager.db
HTSM_SCAN_PATH=                # directory of Illumina run folders to scan

# --- Transfer from sequencer output ---
HTSM_TRANSFER_ENABLED=false
HTSM_TRANSFER_SOURCE_PATH=     # absolute sequencer-output source directory
HTSM_TRANSFER_QUIET_MINUTES=60
HTSM_TRANSFER_POLL_SECONDS=60
HTSM_TRANSFER_REMOVE_SOURCE_ENABLED=false
HTSM_TRANSFER_REMOVE_AFTER_DAYS=0

# --- Virtool upload target ---
VT_UPLOAD_URL=https://preview.virtool.ca/api/uploads
VT_UPLOAD_USER_HANDLE=        # Virtool username (required to upload)
VT_UPLOAD_API_KEY=            # Virtool personal access token (required to upload)
VT_UPLOAD_FILE_TYPE=reads     # `type` query param
